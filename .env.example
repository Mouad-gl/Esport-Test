# Database
DATABASE_URL=postgresql://user:password@localhost:5432/esport_photoshoot
# For local dev with SQLite:
# DATABASE_URL=sqlite:///./esport_photoshoot.db

# Nano Banana 2 API
NANO_BANANA_API_URL=https://api.nanobanana.ai/v2
NANO_BANANA_API_KEY=your_api_key_here
NANO_BANANA_MODEL=nano-banana-2
NANO_BANANA_TIMEOUT=120

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Quality Check
QUALITY_MIN_RESOLUTION=512
QUALITY_MIN_SCORE=60

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
